namespace dm::render {

static const wchar_t* kClassName = L"DMRenderWindow";

static COLORREF parseColor(const std::string& s) {
    if (s.empty()) return RGB(0, 0, 0);
    if (s[0] == '#' && s.size() >= 7) {
        unsigned int r = 0, g = 0, b = 0;
        std::sscanf(s.c_str() + 1, "%02x%02x%02x", &r, &g, &b);
        return RGB(r, g, b);
    }
    if (s[0] == '#' && s.size() >= 4) {
        char rs[2] = {s[1], s[1]};
        char gs[2] = {s[2], s[2]};
        char bs[2] = {s[3], s[3]};
        unsigned int r = 0, g = 0, b = 0;
        std::sscanf(rs, "%x", &r);
        std::sscanf(gs, "%x", &g);
        std::sscanf(bs, "%x", &b);
        return RGB(r, g, b);
    }
    int r = 0, g = 0, b = 0;
    if (std::sscanf(s.c_str(), "%d,%d,%d", &r, &g, &b) == 3) return RGB(r, g, b);
    return RGB(0, 0, 0);
}

static std::wstring utf8ToWide(const std::string& s) {
    if (s.empty()) return L"";
    int len = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0);
    if (len <= 0) return L"";
    std::wstring out(len, L'\0');
    MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), &out[0], len);
    return out;
}

static int fontWeightNum(const std::string& fw) {
    if (fw == "bold") return 700;
    if (fw == "normal" || fw.empty()) return 400;
    try { return std::stoi(fw); } catch (...) { return 400; }
}

static std::wstring pickFontName(const RenderNode* node) {
    if (!node->style.resolvedFontFamily.empty()) {
        return utf8ToWide(node->style.resolvedFontFamily);
    }
    for (const auto& f : node->style.fontFamilyList) {
        if (f.empty()) continue;
        if (f == "serif")      return L"Times New Roman";
        if (f == "sans-serif") return L"Microsoft YaHei";
        if (f == "monospace")  return L"Consolas";
        if (f == "cursive")    return L"Comic Sans MS";
        if (f == "fantasy")    return L"Impact";
        if (f == "system-ui" || f == "ui-sans-serif") return L"Microsoft YaHei";
        if (f == "ui-serif")   return L"Times New Roman";
        if (f == "ui-monospace") return L"Consolas";
        return utf8ToWide(f);
    }
    return L"Microsoft YaHei";
}

// ============================================================
// 渐变
// ============================================================
static bool parseHexColor(const std::string& s, COLORREF& out) {
    std::string t = s;
    auto a = t.find_first_not_of(" \t");
    if (a != std::string::npos) t = t.substr(a);
    while (!t.empty() && (t.back() == ' ' || t.back() == '\t')) t.pop_back();
    if (t.size() >= 1 && t[0] == '#') { out = parseColor(t); return true; }
    if (t.find("rgb") != std::string::npos) { out = parseColor(t); return true; }
    return false;
}

struct GradientStop {
    COLORREF color;
    float    pos;
};

static bool parseStop(const std::string& s, GradientStop& stop) {
    std::istringstream ss(s);
    std::string colorTok, posTok;
    ss >> colorTok;
    if (!ss.eof()) ss >> posTok;
    if (!parseHexColor(colorTok, stop.color)) return false;
    stop.pos = -1;
    if (!posTok.empty() && posTok.back() == '%') {
        try { stop.pos = std::stof(posTok.substr(0, posTok.size() - 1)) / 100.0f; } catch (...) {}
    }
    return true;
}

static bool parseGradientArgs(const std::string& inner,
                              std::vector<GradientStop>& stops,
                              std::string& direction) {
    std::vector<std::string> parts;
    int depth = 0;
    std::string cur;
    for (char c : inner) {
        if (c == '(') { depth++; cur += c; }
        else if (c == ')') { depth--; cur += c; }
        else if (c == ',' && depth == 0) {
            parts.push_back(cur);
            cur.clear();
        } else {
            cur += c;
        }
    }
    if (!cur.empty()) parts.push_back(cur);
    if (parts.size() < 2) return false;

    size_t start = 0;
    std::string first = parts[0];
    auto a = first.find_first_not_of(" \t");
    if (a != std::string::npos) first = first.substr(a);
    if (first.rfind("to ", 0) == 0 || first.find("deg") != std::string::npos) {
        direction = first;
        start = 1;
    } else {
        direction = "to bottom";
    }

    for (size_t i = start; i < parts.size(); i++) {
        GradientStop s;
        if (parseStop(parts[i], s)) stops.push_back(s);
    }
    if (stops.empty()) return false;
    if (stops.front().pos < 0) stops.front().pos = 0.0f;
    if (stops.back().pos < 0) stops.back().pos = 1.0f;
    for (size_t i = 1; i + 1 < stops.size(); i++) {
        if (stops[i].pos < 0) stops[i].pos = (float)i / (stops.size() - 1);
    }
    return true;
}

static COLORREF lerpColor(COLORREF a, COLORREF b, float t) {
    int ar = GetRValue(a), ag = GetGValue(a), ab = GetBValue(a);
    int br = GetRValue(b), bg = GetGValue(b), bb = GetBValue(b);
    return RGB(
        (int)(ar + (br - ar) * t),
        (int)(ag + (bg - ag) * t),
        (int)(ab + (bb - ab) * t)
    );
}

static COLORREF sampleStops(const std::vector<GradientStop>& stops, float t) {
    if (stops.empty()) return RGB(255, 255, 255);
    if (t <= stops.front().pos) return stops.front().color;
    if (t >= stops.back().pos) return stops.back().color;
    for (size_t i = 0; i + 1 < stops.size(); i++) {
        if (t >= stops[i].pos && t <= stops[i + 1].pos) {
            float span = stops[i + 1].pos - stops[i].pos;
            float local = span > 0 ? (t - stops[i].pos) / span : 0;
            return lerpColor(stops[i].color, stops[i + 1].color, local);
        }
    }
    return stops.back().color;
}

static void directionVector(const std::string& dir, float& dx, float& dy) {
    dx = 0; dy = 1;
    if (dir == "to right")        { dx = 1; dy = 0; return; }
    if (dir == "to left")         { dx = -1; dy = 0; return; }
    if (dir == "to top")          { dx = 0; dy = -1; return; }
    if (dir == "to bottom")       { dx = 0; dy = 1; return; }
    if (dir == "to top right")    { dx = 1; dy = -1; return; }
    if (dir == "to top left")     { dx = -1; dy = -1; return; }
    if (dir == "to bottom right") { dx = 1; dy = 1; return; }
    if (dir == "to bottom left")  { dx = -1; dy = 1; return; }

    float deg = 180.0f;
    auto pos = dir.find("deg");
    if (pos != std::string::npos) {
        try { deg = std::stof(dir.substr(0, pos)); } catch (...) {}
    }
    float rad = deg * 3.14159265f / 180.0f;
    dx = std::sin(rad);
    dy = -std::cos(rad);
}

static void paintLinearGradient(HDC hdc, int x, int y, int w, int h,
                                 const std::string& inner) {
    std::vector<GradientStop> stops;
    std::string dir;
    if (!parseGradientArgs(inner, stops, dir)) return;

    float dx, dy;
    directionVector(dir, dx, dy);

    if (std::fabs(dx) >= std::fabs(dy)) {
        for (int i = 0; i < w; ++i) {
            float t = (float)i / (w > 1 ? w - 1 : 1);
            COLORREF c = sampleStops(stops, t);
            HPEN pen = CreatePen(PS_SOLID, 1, c);
            HGDIOBJ old = SelectObject(hdc, pen);
            MoveToEx(hdc, x + i, y, nullptr);
            LineTo(hdc, x + i, y + h);
            SelectObject(hdc, old);
            DeleteObject(pen);
        }
    } else {
        for (int j = 0; j < h; ++j) {
            float t = (float)j / (h > 1 ? h - 1 : 1);
            COLORREF c = sampleStops(stops, t);
            HPEN pen = CreatePen(PS_SOLID, 1, c);
            HGDIOBJ old = SelectObject(hdc, pen);
            MoveToEx(hdc, x, y + j, nullptr);
            LineTo(hdc, x + w, y + j);
            SelectObject(hdc, old);
            DeleteObject(pen);
        }
    }
}

static void paintRadialGradient(HDC hdc, int x, int y, int w, int h,
                                 const std::string& inner) {
    std::vector<GradientStop> stops;
    std::string dir;
    if (!parseGradientArgs(inner, stops, dir)) return;

    float cx = x + w / 2.0f;
    float cy = y + h / 2.0f;
    float maxR = std::sqrt((float)w * w + (float)h * h) / 2.0f;
    if (maxR <= 0) return;

    int step = (int)maxR;
    if (step < 1) step = 1;

    for (int r = step; r >= 0; --r) {
        float t = 1.0f - (float)r / maxR;
        COLORREF c = sampleStops(stops, t);
        HBRUSH br = CreateSolidBrush(c);
        HPEN pen = CreatePen(PS_SOLID, 1, c);
        HGDIOBJ oldBr = SelectObject(hdc, br);
        HGDIOBJ oldPen = SelectObject(hdc, pen);
        Ellipse(hdc, (int)(cx - r), (int)(cy - r),
                     (int)(cx + r), (int)(cy + r));
        SelectObject(hdc, oldBr);
        SelectObject(hdc, oldPen);
        DeleteObject(br);
        DeleteObject(pen);
    }
}

static bool extractGradient(const std::string& raw,
                            std::string& kind,
                            std::string& inner) {
    const char* names[] = { "linear-gradient(", "radial-gradient(",
                            "repeating-linear-gradient(",
                            "repeating-radial-gradient(" };
    const char* kinds[] = { "linear", "radial", "linear", "radial" };
    for (int i = 0; i < 4; ++i) {
        auto p = raw.find(names[i]);
        if (p != std::string::npos) {
            size_t start = p + std::strlen(names[i]);
            int depth = 1;
            size_t j = start;
            while (j < raw.size() && depth > 0) {
                if (raw[j] == '(') depth++;
                else if (raw[j] == ')') { depth--; if (depth == 0) break; }
                j++;
            }
            kind = kinds[i];
            inner = raw.substr(start, j - start);
            return true;
        }
    }
    return false;
}

// 绘制列表标记
static void paintListMarker(HDC hdc, const RenderNode* node) {
    if (node->style.listStyleType.empty() ||
        node->style.listStyleType == "none") return;

    int fs = 16;
    if (!node->style.fontSize.empty()) {
        try { fs = (int)std::stod(node->style.fontSize); } catch (...) {}
    }
    if (fs <= 0) fs = 16;

    int cx = (int)node->layout.x - 12;
    int cy = (int)(node->layout.y + fs * 0.8f);
    int size = fs / 3;
    if (size < 3) size = 3;

    COLORREF col = parseColor(node->style.color);
    if (node->style.color.empty()) col = RGB(0, 0, 0);

    HBRUSH br = CreateSolidBrush(col);
    HPEN pen = CreatePen(PS_SOLID, 1, col);
    HGDIOBJ oldBr = SelectObject(hdc, br);
    HGDIOBJ oldPen = SelectObject(hdc, pen);

    const std::string& t = node->style.listStyleType;
    if (t == "disc") {
        Ellipse(hdc, cx - size, cy - size, cx + size, cy + size);
    } else if (t == "circle") {
        HGDIOBJ nullBrush = SelectObject(hdc, GetStockObject(NULL_BRUSH));
        Ellipse(hdc, cx - size, cy - size, cx + size, cy + size);
        SelectObject(hdc, nullBrush);
    } else if (t == "square") {
        Rectangle(hdc, cx - size, cy - size, cx + size, cy + size);
    } else if (t == "decimal" || t == "decimal-leading-zero") {
        SelectObject(hdc, oldBr);
        SelectObject(hdc, oldPen);
        DeleteObject(br);
        DeleteObject(pen);

        HFONT font = CreateFontW(fs, 0, 0, 0, 400, FALSE, FALSE, FALSE,
                                 DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
                                 CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY,
                                 DEFAULT_PITCH | FF_DONTCARE, L"Microsoft YaHei");
        HGDIOBJ oldFont = SelectObject(hdc, font);
        SetBkMode(hdc, TRANSPARENT);
        SetTextColor(hdc, col);
        wchar_t buf[16];
        std::swprintf(buf, 16, L"%d.", 1);
        RECT tr{cx - 20, cy - fs, cx + 20, cy + fs};
        DrawTextW(hdc, buf, -1, &tr, DT_RIGHT | DT_TOP | DT_SINGLELINE);
        SelectObject(hdc, oldFont);
        DeleteObject(font);
        return;
    }

    SelectObject(hdc, oldBr);
    SelectObject(hdc, oldPen);
    DeleteObject(br);
    DeleteObject(pen);
}

RenderWindow::RenderWindow() = default;

RenderWindow::~RenderWindow() {
    if (hwnd_) DestroyWindow(hwnd_);
}

bool RenderWindow::create(const std::wstring& title, int w, int h) {
    width_ = w; height_ = h;

    WNDCLASSEXW wc{};
    wc.cbSize = sizeof(wc);
    wc.style = CS_HREDRAW | CS_VREDRAW;
    wc.lpfnWndProc = WndProc;
    wc.hInstance = GetModuleHandle(nullptr);
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wc.lpszClassName = kClassName;
    RegisterClassExW(&wc);

    hwnd_ = CreateWindowExW(0, kClassName, title.c_str(),
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT, w, h,
        nullptr, nullptr, GetModuleHandle(nullptr), this);
    if (!hwnd_) return false;

    SetWindowLongPtrW(hwnd_, GWLP_USERDATA, (LONG_PTR)this);
    ShowWindow(hwnd_, SW_SHOW);
    UpdateWindow(hwnd_);
    return true;
}

// iter4: paintNode 支持 filter + opacity 合成
void RenderWindow::paintNode(HDC hdc, const RenderNode* node) {
    if (!node) return;
    if (!node->isText && node->style.display == "none") return;

    bool hasFilter = !node->isText &&
                     !node->style.filterRaw.empty() &&
                     node->style.filterRaw != "none" &&
                     node->layout.w > 0 && node->layout.h > 0;
    bool hasOpacity = !node->isText &&
                      node->style.opacity < 1.0f &&
                      node->style.opacity >= 0.0f &&
                      node->layout.w > 0 && node->layout.h > 0;

    if (hasFilter || hasOpacity) {
        paintNodeWithFilter(hdc, node,
                            hasFilter ? node->style.filterRaw : "",
                            node->style.opacity);
        return;
    }

    paintNodeInner(hdc, node);
}

void RenderWindow::paintNodeInner(HDC hdc, const RenderNode* node) {
    if (!node) return;
    if (!node->isText && node->style.display == "none") return;

    if (node->tag == "#document") {
        for (auto& c : node->children) paintNode(hdc, c.get());
        return;
    }

    if (node->isText) {
        if (node->text.empty()) return;
        const Layout& L = node->layout;
        if (L.w <= 0 || L.h <= 0) return;

        int x = (int)L.x, y = (int)L.y, w = (int)L.w, h = (int)L.h;

        int fs = 16;
        if (!node->style.fontSize.empty()) {
            try { fs = (int)std::stod(node->style.fontSize); } catch (...) {}
        }
        if (fs <= 0) fs = 16;

        int weight = fontWeightNum(node->style.fontWeight);
        std::wstring fontName = pickFontName(node);

        HFONT font = CreateFontW(fs, 0, 0, 0, weight,
                                 node->style.fontStyle == "italic" ? TRUE : FALSE,
                                 FALSE, FALSE,
                                 DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
                                 CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY,
                                 DEFAULT_PITCH | FF_DONTCARE, fontName.c_str());
        HGDIOBJ oldFont = SelectObject(hdc, font);

        SetBkMode(hdc, TRANSPARENT);
        SetTextColor(hdc, parseColor(node->style.color));

        std::wstring wtext = utf8ToWide(node->text);
        RECT tr{x, y, x + w + 4, y + h + 4};
        DrawTextW(hdc, wtext.c_str(), -1, &tr,
                  DT_LEFT | DT_TOP | DT_SINGLELINE | DT_NOCLIP);

        SelectObject(hdc, oldFont);
        DeleteObject(font);
        return;
    }

    const Layout& L = node->layout;
    int x = (int)L.x, y = (int)L.y, w = (int)L.w, h = (int)L.h;

    bool hasTransform = !node->style.transform.empty();
    XFORM oldXform{};
    if (hasTransform) {
        float angle = 0, sx = 1, sy = 1, tx = 0, ty = 0;
        const std::string& t = node->style.transform;
        size_t p = 0;
        while (p < t.size()) {
            while (p < t.size() && (t[p] == ' ' || t[p] == ',')) p++;
            if (p >= t.size()) break;
            size_t nameStart = p;
            while (p < t.size() && (std::isalpha((unsigned char)t[p]) || t[p] == '-')) p++;
            std::string fn = t.substr(nameStart, p - nameStart);
            while (p < t.size() && t[p] != '(') p++;
            if (p >= t.size()) break;
            size_t argStart = p + 1;
            size_t argEnd = t.find(')', argStart);
            if (argEnd == std::string::npos) break;
            std::string args = t.substr(argStart, argEnd - argStart);
            p = argEnd + 1;

            if (fn == "rotate") {
                angle += (float)std::atof(args.c_str());
            } else if (fn == "scale") {
                float s = (float)std::atof(args.c_str());
                sx *= s; sy *= s;
            } else if (fn == "scaleX") {
                sx *= (float)std::atof(args.c_str());
            } else if (fn == "scaleY") {
                sy *= (float)std::atof(args.c_str());
            } else if (fn == "translate") {
                std::istringstream ss(args);
                std::string a1, a2;
                std::getline(ss, a1, ',');
                if (!std::getline(ss, a2, ',')) a2 = "0";
                Length l1 = parseLength(a1);
                Length l2 = parseLength(a2);
                int fs0 = 16;
                try { fs0 = (int)std::stod(node->style.fontSize); } catch (...) {}
                tx += resolveLength(l1, fs0, 16, width_, height_, 0);
                ty += resolveLength(l2, fs0, 16, width_, height_, 0);
            }
        }

        float cx = x + w / 2.0f;
        float cy = y + h / 2.0f;
        float rad = angle * 3.14159265f / 180.0f;

        XFORM xf{};
        xf.eM11 =  cos(rad) * sx;
        xf.eM12 =  sin(rad) * sx;
        xf.eM21 = -sin(rad) * sy;
        xf.eM22 =  cos(rad) * sy;
        xf.eDx  = cx - (cx * xf.eM11 + cy * xf.eM21) + tx;
        xf.eDy  = cy - (cx * xf.eM12 + cy * xf.eM22) + ty;

        GetWorldTransform(hdc, &oldXform);
        SetGraphicsMode(hdc, GM_ADVANCED);
        SetWorldTransform(hdc, &xf);
    }

    int clipSaved = 0;
    bool doClip = false;
    if ((node->style.overflow == "hidden" || node->style.overflow == "clip") && w > 0 && h > 0) {
        clipSaved = SaveDC(hdc);
        HRGN rgn = CreateRectRgn(x, y, x + w, y + h);
        SelectClipRgn(hdc, rgn);
        DeleteObject(rgn);
        doClip = true;
    }

    if (w > 0 && h > 0) {
        int saved = SaveDC(hdc);

        // iter3: 图片绘制
        if (node->tag == "img" && node->image.valid()) {
            int imgW = node->image.width;
            int imgH = node->image.height;
            BITMAPINFO bi{};
            bi.bmiHeader.biSize        = sizeof(BITMAPINFOHEADER);
            bi.bmiHeader.biWidth       = imgW;
            bi.bmiHeader.biHeight      = -imgH;
            bi.bmiHeader.biPlanes      = 1;
            bi.bmiHeader.biBitCount    = 32;
            bi.bmiHeader.biCompression = BI_RGB;

            void* bits = nullptr;
            HDC memDC = CreateCompatibleDC(hdc);
            HBITMAP memBmp = CreateDIBSection(memDC, &bi, DIB_RGB_COLORS,
                                               &bits, nullptr, 0);
            if (memBmp && bits) {
                std::memcpy(bits, node->image.bgra.data(), node->image.bgra.size());
                HBITMAP oldBmp = (HBITMAP)SelectObject(memDC, memBmp);
                BLENDFUNCTION bf{ AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
                AlphaBlend(hdc, x, y, w, h, memDC, 0, 0, imgW, imgH, bf);
                SelectObject(memDC, oldBmp);
                DeleteObject(memBmp);
            }
            DeleteDC(memDC);
        }
        // 渐变
        else if (!node->style.backgroundImageRaw.empty()) {
            std::string kind, inner;
            if (extractGradient(node->style.backgroundImageRaw, kind, inner)) {
                if (kind == "linear") {
                    paintLinearGradient(hdc, x, y, w, h, inner);
                } else {
                    paintRadialGradient(hdc, x, y, w, h, inner);
                }
            }
        }
        // url 背景
        else if (!node->style.backgroundImage.empty()) {
            auto hash = node->style.backgroundImage.find('#');
            if (hash != std::string::npos && hash + 7 <= node->style.backgroundImage.size()) {
                std::string col = node->style.backgroundImage.substr(hash, 7);
                RECT r{x, y, x + w, y + h};
                HBRUSH br = CreateSolidBrush(parseColor(col));
                FillRect(hdc, &r, br);
                DeleteObject(br);
            }
        }

        if (!node->style.backgroundColor.empty() &&
            node->style.backgroundColor != "0,0,0,0" &&
            node->style.backgroundColor != "0,0,0" &&
            node->style.backgroundImageRaw.empty() &&
            !(node->tag == "img" && node->image.valid())) {
            RECT r{x, y, x + w, y + h};
            HBRUSH br = CreateSolidBrush(parseColor(node->style.backgroundColor));

            if (node->style.hasBorderRadius && node->style.borderRadius.value > 0) {
                int radius = (int)node->style.borderRadius.value;
                HPEN pen = CreatePen(PS_SOLID, 1, parseColor(node->style.backgroundColor));
                HGDIOBJ oldPen = SelectObject(hdc, pen);
                HGDIOBJ oldBr = SelectObject(hdc, br);
                RoundRect(hdc, x, y, x + w, y + h, radius * 2, radius * 2);
                SelectObject(hdc, oldPen);
                SelectObject(hdc, oldBr);
                DeleteObject(pen);
            } else {
                FillRect(hdc, &r, br);
            }
            DeleteObject(br);
        }

        if (node->style.borderWidth.value > 0 &&
            !node->style.borderStyle.empty() &&
            node->style.borderStyle != "none") {
            COLORREF bc = RGB(128, 128, 128);
            if (!node->style.borderColor.empty()) bc = parseColor(node->style.borderColor);
            HPEN pen = CreatePen(PS_SOLID, (int)node->style.borderWidth.value, bc);
            HGDIOBJ oldPen = SelectObject(hdc, pen);
            HGDIOBJ oldBrush = SelectObject(hdc, GetStockObject(NULL_BRUSH));
            Rectangle(hdc, x, y, x + w, y + h);
            SelectObject(hdc, oldPen);
            SelectObject(hdc, oldBrush);
            DeleteObject(pen);
        }

        // iter4: 表单控件外观
        if (node->tag == "input" || node->tag == "button" || node->tag == "select") {
            int fs = 14;
            if (!node->style.fontSize.empty()) {
                try { fs = (int)std::stod(node->style.fontSize); } catch (...) {}
            }
            if (fs <= 0) fs = 14;
            if (fs > 14) fs = 14;

            HFONT font = CreateFontW(fs, 0, 0, 0, 400, FALSE, FALSE, FALSE,
                                     DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
                                     CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY,
                                     DEFAULT_PITCH | FF_DONTCARE, L"Microsoft YaHei");
            HGDIOBJ oldFont = SelectObject(hdc, font);
            SetBkMode(hdc, TRANSPARENT);
            SetTextColor(hdc, RGB(80, 80, 80));

            std::wstring label;
            auto vit = node->attrs.find("value");
            if (vit != node->attrs.end() && !vit->second.empty()) {
                label = utf8ToWide(vit->second);
            } else if (node->tag == "input") {
                auto pit = node->attrs.find("placeholder");
                if (pit != node->attrs.end() && !pit->second.empty()) {
                    label = utf8ToWide(pit->second);
                    SetTextColor(hdc, RGB(160, 160, 160));
                }
            } else if (!node->text.empty()) {
                label = utf8ToWide(node->text);
            }

            if (!label.empty()) {
                RECT tr{x + 4, y, x + w - 4, y + h};
                UINT fmt = DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS;
                if (node->tag == "button") fmt = DT_CENTER | DT_VCENTER | DT_SINGLELINE;
                DrawTextW(hdc, label.c_str(), -1, &tr, fmt);
            }

            SelectObject(hdc, oldFont);
            DeleteObject(font);
        }

        if (node->style.display == "list-item") {
            paintListMarker(hdc, node);
        }

        if (!node->text.empty() && node->tag != "img") {
            int fs = 16;
            if (!node->style.fontSize.empty()) {
                try { fs = (int)std::stod(node->style.fontSize); } catch (...) {}
            }
            if (fs <= 0) fs = 16;
            int weight = fontWeightNum(node->style.fontWeight);
            std::wstring fontName = pickFontName(node);

            HFONT font = CreateFontW(fs, 0, 0, 0, weight,
                                     node->style.fontStyle == "italic" ? TRUE : FALSE,
                                     FALSE, FALSE,
                                     DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
                                     CLIP_DEFAULT_PRECIS, DEFAULT_QUALITY,
                                     DEFAULT_PITCH | FF_DONTCARE, fontName.c_str());
            HGDIOBJ oldFont = SelectObject(hdc, font);
            SetBkMode(hdc, TRANSPARENT);
            SetTextColor(hdc, parseColor(node->style.color));

            std::wstring wtext = utf8ToWide(node->text);
            RECT tr{x, y, x + w, y + h + 4};
            DrawTextW(hdc, wtext.c_str(), -1, &tr,
                      DT_LEFT | DT_TOP | DT_SINGLELINE | DT_END_ELLIPSIS);

            SelectObject(hdc, oldFont);
            DeleteObject(font);
        }

        RestoreDC(hdc, saved);
    }

    std::vector<RenderNode*> sorted;
    for (auto& c : node->children) sorted.push_back(c.get());
    std::stable_sort(sorted.begin(), sorted.end(),
        [](const RenderNode* a, const RenderNode* b) {
            int za = a->style.hasZIndex ? a->style.zIndexValue : 0;
            int zb = b->style.hasZIndex ? b->style.zIndexValue : 0;
            return za < zb;
        });
    for (auto* c : sorted) paintNode(hdc, c);

    if (doClip) RestoreDC(hdc, clipSaved);

    if (hasTransform) {
        SetWorldTransform(hdc, &oldXform);
        SetGraphicsMode(hdc, GM_COMPATIBLE);
    }
}

void RenderWindow::paintNodeWithOpacity(HDC hdc, const RenderNode* node, float opacity) {
    int x = (int)node->layout.x;
    int y = (int)node->layout.y;
    int w = (int)node->layout.w;
    int h = (int)node->layout.h;
    if (w <= 0 || h <= 0) { paintNodeInner(hdc, node); return; }

    BITMAPINFO bi{};
    bi.bmiHeader.biSize        = sizeof(BITMAPINFOHEADER);
    bi.bmiHeader.biWidth       = w;
    bi.bmiHeader.biHeight      = -h;
    bi.bmiHeader.biPlanes      = 1;
    bi.bmiHeader.biBitCount    = 32;
    bi.bmiHeader.biCompression = BI_RGB;

    void* bits = nullptr;
    HDC memDC = CreateCompatibleDC(hdc);
    HBITMAP memBmp = CreateDIBSection(memDC, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    if (!memBmp || !bits) {
        if (memBmp) DeleteObject(memBmp);
        DeleteDC(memDC);
        paintNodeInner(hdc, node);
        return;
    }

    HBITMAP oldBmp = (HBITMAP)SelectObject(memDC, memBmp);
    SetViewportOrgEx(memDC, -x, -y, nullptr);

    DWORD* p = (DWORD*)bits;
    for (int i = 0; i < w * h; ++i) p[i] = 0x00FF00FF;

    paintNodeInner(memDC, node);

    SetViewportOrgEx(memDC, 0, 0, nullptr);

    BYTE a = (BYTE)(opacity * 255.0f + 0.5f);
    for (int i = 0; i < w * h; ++i) {
        DWORD px = p[i];
        if ((px & 0x00FFFFFF) == 0x00FF00FF) {
            p[i] = 0;
        } else {
            p[i] = (px & 0x00FFFFFF) | ((DWORD)a << 24);
        }
    }

    BLENDFUNCTION bf{ AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
    AlphaBlend(hdc, x, y, w, h, memDC, 0, 0, w, h, bf);

    SelectObject(memDC, oldBmp);
    DeleteObject(memBmp);
    DeleteDC(memDC);
}

// iter4: filter + opacity 合成
void RenderWindow::paintNodeWithFilter(HDC hdc, const RenderNode* node,
                                        const std::string& filterStr,
                                        float opacity) {
    int x = (int)node->layout.x;
    int y = (int)node->layout.y;
    int w = (int)node->layout.w;
    int h = (int)node->layout.h;
    if (w <= 0 || h <= 0) { paintNodeInner(hdc, node); return; }

    BITMAPINFO bi{};
    bi.bmiHeader.biSize        = sizeof(BITMAPINFOHEADER);
    bi.bmiHeader.biWidth       = w;
    bi.bmiHeader.biHeight      = -h;
    bi.bmiHeader.biPlanes      = 1;
    bi.bmiHeader.biBitCount    = 32;
    bi.bmiHeader.biCompression = BI_RGB;

    void* bits = nullptr;
    HDC memDC = CreateCompatibleDC(hdc);
    HBITMAP memBmp = CreateDIBSection(memDC, &bi, DIB_RGB_COLORS, &bits, nullptr, 0);
    if (!memBmp || !bits) {
        if (memBmp) DeleteObject(memBmp);
        DeleteDC(memDC);
        paintNodeInner(hdc, node);
        return;
    }

    HBITMAP oldBmp = (HBITMAP)SelectObject(memDC, memBmp);
    SetViewportOrgEx(memDC, -x, -y, nullptr);

    DWORD* p = (DWORD*)bits;
    for (int i = 0; i < w * h; ++i) p[i] = 0x00FF00FF;

    paintNodeInner(memDC, node);

    SetViewportOrgEx(memDC, 0, 0, nullptr);

    std::vector<unsigned char> buf((size_t)w * h * 4);
    for (int i = 0; i < w * h; ++i) {
        DWORD px = p[i];
        if ((px & 0x00FFFFFF) == 0x00FF00FF) {
            buf[i * 4 + 0] = 0;
            buf[i * 4 + 1] = 0;
            buf[i * 4 + 2] = 0;
            buf[i * 4 + 3] = 0;
        } else {
            buf[i * 4 + 0] = (unsigned char)((px >> 0)  & 0xFF);
            buf[i * 4 + 1] = (unsigned char)((px >> 8)  & 0xFF);
            buf[i * 4 + 2] = (unsigned char)((px >> 16) & 0xFF);
            buf[i * 4 + 3] = (unsigned char)((px >> 24) & 0xFF);
        }
    }

    if (!filterStr.empty()) {
        auto filters = parseFilterList(filterStr);
        applyFilters(buf, w, h, filters);
    }

    BYTE alphaVal = (BYTE)(opacity * 255.0f + 0.5f);
    for (int i = 0; i < w * h; ++i) {
        unsigned char B = buf[i * 4 + 0];
        unsigned char G = buf[i * 4 + 1];
        unsigned char R = buf[i * 4 + 2];
        unsigned char A = buf[i * 4 + 3];
        if (opacity < 1.0f) {
            A = (unsigned char)((A * alphaVal) / 255);
        }
        p[i] = ((DWORD)A << 24) | ((DWORD)R << 16) | ((DWORD)G << 8) | (DWORD)B;
    }

    BLENDFUNCTION bf{ AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
    AlphaBlend(hdc, x, y, w, h, memDC, 0, 0, w, h, bf);

    SelectObject(memDC, oldBmp);
    DeleteObject(memBmp);
    DeleteDC(memDC);
}

void RenderWindow::paint(HDC hdc) {
    RECT rc; GetClientRect(hwnd_, &rc);
    HBRUSH bg = CreateSolidBrush(RGB(255, 255, 255));
    FillRect(hdc, &rc, bg);
    DeleteObject(bg);

    if (root_) paintNode(hdc, root_);
}

LRESULT CALLBACK RenderWindow::WndProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
    RenderWindow* self = (RenderWindow*)GetWindowLongPtrW(hwnd, GWLP_USERDATA);

    switch (msg) {
        case WM_CREATE: {
            auto* cs = (CREATESTRUCT*)lp;
            self = (RenderWindow*)cs->lpCreateParams;
            SetWindowLongPtrW(hwnd, GWLP_USERDATA, (LONG_PTR)self);
            if (self) self->hwnd_ = hwnd;
            return 0;
        }
        case WM_PAINT: {
            if (self) {
                PAINTSTRUCT ps;
                HDC hdc = BeginPaint(hwnd, &ps);
                self->paint(hdc);
                EndPaint(hwnd, &ps);
            }
            return 0;
        }
        case WM_SIZE: {
            if (self) {
                self->width_ = LOWORD(lp);
                self->height_ = HIWORD(lp);
                InvalidateRect(hwnd, nullptr, TRUE);
            }
            return 0;
        }
        case WM_ERASEBKGND:
            return 1;
        case WM_DESTROY:
            PostQuitMessage(0);
            return 0;
    }
    return DefWindowProcW(hwnd, msg, wp, lp);
}

int RenderWindow::run() {
    MSG msg;
    while (GetMessageW(&msg, nullptr, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }
    return (int)msg.wParam;
}

} // namespace dm::render